<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_max_account_password_log_list" model="ir.ui.view">
        <field name="name">max.account.password.log.list</field>
        <field name="model">max.account.password.log</field>
        <field name="arch" type="xml">
            <list string="Nhật ký mật khẩu" create="0" edit="0" delete="0">
                <field name="performed_date"/>
                <field name="action"/>
                <field name="user_id"/>
                <field name="login"/>
                <field name="partner_id"/>
                <field name="performed_by_id"/>
                <field name="old_state"/>
                <field name="new_state"/>
            </list>
        </field>
    </record>

    <record id="view_max_account_password_log_form" model="ir.ui.view">
        <field name="name">max.account.password.log.form</field>
        <field name="model">max.account.password.log</field>
        <field name="arch" type="xml">
            <form string="Nhật ký mật khẩu" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="performed_date"/>
                            <field name="action"/>
                            <field name="performed_by_id"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="login"/>
                            <field name="partner_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="old_state"/>
                        <field name="new_state"/>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_max_account_password_log" model="ir.actions.act_window">
        <field name="name">Nhật ký mật khẩu</field>
        <field name="res_model">max.account.password.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
