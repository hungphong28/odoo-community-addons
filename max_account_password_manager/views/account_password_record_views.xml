<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_max_account_password_record_list" model="ir.ui.view">
        <field name="name">max.account.password.record.list</field>
        <field name="model">max.account.password.record</field>
        <field name="arch" type="xml">
            <list string="Bản ghi mật khẩu" decoration-warning="state == 'out_of_sync'">
                <field name="name"/>
                <field name="user_id"/>
                <field name="login"/>
                <field name="partner_id"/>
                <field name="password_masked"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'managed'"
                       decoration-warning="state == 'out_of_sync'"/>
                <field name="source"/>
                <field name="password_last_set_date"/>
                <field name="password_set_by_id"/>
            </list>
        </field>
    </record>

    <record id="view_max_account_password_record_form" model="ir.ui.view">
        <field name="name">max.account.password.record.form</field>
        <field name="model">max.account.password.record</field>
        <field name="arch" type="xml">
            <form string="Bản ghi mật khẩu">
                <header>
                    <button name="action_copy_password"
                            type="object"
                            string="Sao chép mật khẩu"
                            class="btn-primary"
                            invisible="not password_value"/>
                    <field name="state" widget="statusbar" statusbar_visible="managed,out_of_sync"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1" nolabel="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Tài khoản">
                            <field name="user_id" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="login"/>
                            <field name="password_value" password="True" readonly="1"/>
                            <field name="source"/>
                        </group>

                        <group string="Quản lý">
                            <field name="password_last_set_date"/>
                            <field name="password_set_by_id"/>
                        </group>
                    </group>

                    <group string="Ghi chú" col="1">
                        <field name="note"
                               readonly="1"
                               nolabel="1"
                               colspan="4"
                               class="w-100"
                               placeholder="Không có ghi chú."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_max_account_password_record" model="ir.actions.act_window">
        <field name="name">Bản ghi mật khẩu</field>
        <field name="res_model">max.account.password.record</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
