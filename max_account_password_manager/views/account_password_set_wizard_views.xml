<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_max_account_password_set_wizard_form" model="ir.ui.view">
        <field name="name">max.account.password.set.wizard.form</field>
        <field name="model">max.account.password.set.wizard</field>
        <field name="arch" type="xml">
            <form string="Đặt mật khẩu quản lý">
                <sheet>
                    <group>
                        <field name="user_id"/>
                        <field name="password_was_generated" invisible="1"/>
                    </group>

                    <group string="Mật khẩu quản lý">
                        <label for="password"/>
                        <div class="o_row">
                            <field name="password" nolabel="1"/>
                            <button name="action_generate_password"
                                    type="object"
                                    string="Tạo"
                                    class="btn-secondary"/>
                        </div>
                        <field name="confirm_password"/>
                    </group>

                    <group string="Đánh giá mật khẩu">
                        <field name="password_length"/>
                        <field name="password_strength" widget="badge"
                               decoration-danger="password_strength == 'weak'"
                               decoration-warning="password_strength == 'medium'"
                               decoration-success="password_strength in ('strong', 'very_strong')"/>
                        <field name="password_strength_note" readonly="1"/>
                    </group>

                    <group>
                        <field name="note" placeholder="Lý do hoặc ghi chú khi đặt mật khẩu quản lý..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_set_password"
                            type="object"
                            string="Đặt mật khẩu"
                            class="btn-primary"/>
                    <button string="Hủy"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
